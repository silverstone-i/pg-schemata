{
  "name": "pg-schemata",
  "version": "2.0.0",
  "homepage": "https://silverstone-i.github.io/pg-schemata/",
  "description": "A lightweight Postgres-first ORM layer built on top of pg-promise",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "postgres",
    "pg-promise",
    "orm",
    "schema",
    "nodejs"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:exports": "attw --pack . --profile esm-only",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run check:exports",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Ian Silverstone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverstone-i/pg-schemata.git"
  },
  "dependencies": {
    "@nap-sft/tablsx": "^0.1.3",
    "dotenv": "^16.5.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.1.0",
    "pg-promise": "^11.13.0",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-headers": "^1.3.4",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^2.0.0-alpha.12",
    "vitest": "^3.1.4"
  }
}
