# Copy to .env and adjust for your machine.
#
# Only DATABASE_URL is read by the library and the test suite.
#
# The integration suite (`npm run test:integration`) needs this database to
# exist, but it needs nothing inside it — no extensions, no tables. Each test
# creates and drops its own uniquely-named schema. Requires PostgreSQL 13+.
#
#   createdb pg_schemata_test
#
# Unit tests (`npm run test:unit`) need no database at all.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pg_schemata_test
